<?xml version="1.0"?>
<package format="3">
  <name>bemu_locomotion</name>
  <version>0.1.0</version>
  <description>The Bemu walker node: velocity, body pose and gait commands to joint targets.</description>
  <maintainer email="noreply@example.com">Bemu</maintainer>
  <license>Proprietary</license>
  <depend>bemu_params</depend>
  <depend>bemu_kinematics</depend>
